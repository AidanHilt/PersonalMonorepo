#!/bin/bash

# Sourced into interactive shells. Rules:
#  - Function name must match the directory name.
#  - Use return, never exit.
#  - No set -e / set -u / set -o pipefail (they leak into the user's shell).
#  - Declare variables local.
#  - No #include support: this file is concatenated verbatim, so don't call lib functions.

__NAME__() {
  case "${1:-}" in
  --help | -h)
    echo "Usage: __NAME__ [OPTIONS]"
    return 0
    ;;
  esac
}
