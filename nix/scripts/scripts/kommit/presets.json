{
  "types": [
    "feat",
    "fix",
    "chore",
    "docs",
    "style",
    "refactor",
    "perf",
    "test",
    "build",
    "ci",
    "revert"
  ],
  "presets": [
    {
      "name": "argocd",
      "scope": "deployment",
      "paths": [
        "kubernetes/*"
      ]
    },
    {
      "name": "mono-flake",
      "scope": "deployment",
      "paths": [
        "nix/mono-flake/*",
        "nix/scripts/*"
      ]
    },
    {
      "name": "actions",
      "type": "ci",
      "scope": "deployment",
      "paths": [
        "nix/scripts/*",
        ".github/*"
      ]
    },
    {
      "name": "containers",
      "paths": [
        "nix/custom-images"
      ]
    }
  ]
}
