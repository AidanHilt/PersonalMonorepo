# Secrets and local overrides — never commit these.
.env
# gen-kubeconfig.sh writes outside the repo by default
# (~/.config/pi-sandbox/agent-kubeconfig.yaml, or
# $PI_SANDBOX__KUBECONFIG_PATH); there is no in-repo kubeconfig path
# anymore.

# Local auth store, if ever pointed inside the repo by mistake.
.config/
auth-store/

# Nix
result
result-*

# The project the agent works on is expected to live outside this repo
# in normal use, but if PERSONAL_MONOREPO_LOCATION defaults into ./workspace here:
/workspace/

node_modules/
