# Copy to .env and fill in what you need. .env is gitignored — never
# commit real values (spec §5 "hard constraint", §7).
#
# Prefer `nix run .#login` (OAuth, spec §3.4/§7) over static keys where
# the provider/tier supports it. Set keys here only as a fallback.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Where to bind-mount the project the agent should work on.
PERSONAL_MONOREPO_LOCATION=./workspace

# OAuth credentials (spec §7) are no longer a host-side directory —
# they're stored in the `pi-auth` Docker named volume, populated by
# running `nix run .#login` (the containerized `login` compose profile).
# Nothing to configure here.

# Local Ollama support is currently disabled (see containers/proxy for
# the commented-out gate). Left here in case it's revived later.
# OLLAMA_UPSTREAM=host.docker.internal:11434
# OLLAMA_HOST_URL=http://127.0.0.1:11434
