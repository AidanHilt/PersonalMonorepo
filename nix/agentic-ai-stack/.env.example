# Copy to .env and fill in what you need. .env is gitignored — never
# commit real values (spec §5 "hard constraint", §7).
#
# This file is ONLY for non-secret vars Docker Compose interpolates into
# compose.yaml (e.g. `${PERSONAL_MONOREPO_LOCATION:-...}`) — it no longer
# carries any API keys or other credentials. Secrets (frontier provider
# keys, EXA_API_KEY, GITHUB_TOKEN, etc.) go through start-agent.sh's
# repeatable `--secret NAME=VALUE` flag, or by exporting a
# `PI_SANDBOX__SECRET__<NAME>` env var on the host before running it.
# start-agent.sh never retrieves or decrypts secrets itself — it only
# injects already-decrypted values.

# Location of this monorepo checkout on the host. Used by start-agent.sh/
# stop-agent.sh to find this stack's own files and (optionally) a local
# nix/scripts checkout -- it is NOT a /workspace bind mount anymore. Use
# start-agent.sh's repeatable `--add PATH` / `--clone URL` flags to give
# `pi` something to work on (see README.md).
PERSONAL_MONOREPO_LOCATION=./workspace

# OAuth credentials (spec §7) are no longer a host-side directory —
# they're stored in the `pi-auth` Docker named volume, populated by
# running `nix run .#login` (the containerized `login` compose profile).
# Nothing to configure here.

# Local Ollama support is currently disabled (see containers/proxy for
# the commented-out gate). Left here in case it's revived later.
# OLLAMA_UPSTREAM=host.docker.internal:11434
# OLLAMA_HOST_URL=http://127.0.0.1:11434
