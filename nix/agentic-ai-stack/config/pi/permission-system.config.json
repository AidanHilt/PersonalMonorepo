{
  "yoloMode": false,
  "debugLog": false,
  "permissionReviewLog": true,
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*/.kube/*": "deny",
      "*kubeconfig*": "deny",
      "*/.ssh/*": "deny",
      "*/.aws/*": "deny",
      "*/.config/gcloud/*": "deny",
      "*.pem": "deny",
      "*serviceaccount*.json": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      ".git/*": "deny"
    },
    "read": "allow",
    "find": "allow",
    "grep": "allow",
    "ls": "allow",
    "write": "ask",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "cd *": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "which *": "allow",
      "git *": "ask",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "nix build *": "allow",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "kubectl apply *": "deny",
      "kubectl delete *": "deny",
      "kubectl exec *": "deny"
    },
    "external_directory_read": "allow",
    "external_directory_write": "ask"
  }
}