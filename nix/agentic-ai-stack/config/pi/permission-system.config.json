{
  "_comment": "Schema/field names verified against @gotgenes/pi-permission-system 32.0.2 (README + ADR-0013). Four layers compose most-restrictive-wins: path (cross-cutting) -> external_directory -> per-tool (read/write/edit) -> bash patterns. Re-check this file against that package's docs/configuration.md whenever bumping its pinned version in containers/pi/npm-src/package.json.",

  "yoloMode": false,
  "debugLog": false,
  "permissionReviewLog": true,

  "permission": {
    "*": "allow",

    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "**/.kube/**": "deny",
      "**/kubeconfig*": "deny",
      "**/.ssh/**": "deny",
      "**/.aws/**": "deny",
      "**/.config/gcloud/**": "deny",
      "**/*.pem": "deny",
      "**/*serviceaccount*.json": "deny",
      "**/id_rsa*": "deny",
      "**/id_ed25519*": "deny"
    },

    "read": "allow",
    "write": "ask",
    "edit": "ask",

    "bash": {
      "*": "ask",
      "git *": "allow",
      "npm test*": "allow",
      "npm run build*": "allow",
      "npm run lint*": "allow",
      "npm ci*": "allow",
      "make test*": "allow",
      "make build*": "allow",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "kubectl apply *": "deny",
      "kubectl delete *": "deny",
      "kubectl exec *": "deny"
    },

    "external_directory": "ask"
  }
}
