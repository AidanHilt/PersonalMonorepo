{
  "yoloMode": false,
  "debugLog": false,
  "permissionReviewLog": true,
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*/.kube/*": "deny",
      "*kubeconfig*": "deny",
      "*/.ssh/*": "deny",
      "*/.aws/*": "deny",
      "*/.config/gcloud/*": "deny",
      "*.pem": "deny",
      "*serviceaccount*.json": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      ".git/*": "deny"
    },
    "path_read": {
      "/home/pi/.pi/*": "allow"
    },
    "path_write": {
      "/home/pi/.pi/*": "deny"
    },
    "read": "allow",
    "find": "allow",
    "grep": "allow",
    "ls": "allow",
    "write": "deny",
    "edit": "deny",
    "bash": {
      "*": "ask",
      "cd *": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "sort *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "which *": "allow",
      "tree *": "allow",
      "stat *": "allow",
      "diff *": "allow",
      "dirname *": "allow",
      "basename *": "allow",
      "realpath *": "allow",
      "jq *": "allow",
      "python3": "deny",
      "find *": "ask",
      "find * -exec*": "deny",
      "find * -execdir*": "deny",
      "find * -ok*": "deny",
      "find * -okdir*": "deny",
      "find * -delete*": "deny",
      "find * -fprint*": "deny",
      "find * -fprintf*": "deny",
      "find * -fls*": "deny",
      "git *": "deny",
      "nix *": "deny",
      "sed *": "deny",
      "xargs *": "deny",
      "env *": "deny",
      "printenv *": "deny",
      "export *": "deny",
      "set *": "deny",
      "eval *": "deny",
      "exec *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "nc *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "kubectl apply *": "deny",
      "kubectl delete *": "deny",
      "kubectl exec *": "deny",
      "echo *": "deny",
      "cp *": "deny",
      "rm *": "deny",
      "mkdir *": "deny"
    },
    "external_directory_read": {
      "/home/pi/.pi/*": "allow"
    },
    "external_directory_write": {
      "*": "deny"
    }
  }
}
